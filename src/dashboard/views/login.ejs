<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <i class="fas fa-dice"></i>
                <h1>Connexion</h1>
                <p>Connectez-vous avec votre compte Discord pour accéder au dashboard</p>
            </div>
            <div class="login-body">
                <a href="/auth/discord" class="btn btn-discord">
                    <i class="fab fa-discord"></i>
                    Connexion avec Discord
                </a>
                <p class="login-note">
                    <i class="fas fa-info-circle"></i>
                    Nous demandons uniquement les permissions nécessaires pour le fonctionnement du dashboard.
                </p>
            </div>
        </div>
    </div>
</body>
</html>
